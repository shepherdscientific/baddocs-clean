# --- Inference endpoint (any OpenAI-compatible API) -----------------------
# Used by the server's generation + the /api/try-it demo. Point at a budgeted
# endpoint for the hosted demo (e.g. an OpenRouter key with a spend cap).
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# --- Try-it demo caps -----------------------------------------------------
# The endpoint enforces only technical caps; put the real abuse gate
# (Turnstile / auth / quotas) in front of it. Keep this small for a public demo.
BADDOCS_TRY_MAX_FILES=6
BADDOCS_TRY_CLONE_TIMEOUT=60

# --- Infra (compose provides sane defaults) -------------------------------
DATABASE_URL=postgresql://baddocs:baddocs@db:5432/baddocs
REDIS_URL=redis://redis:6379/0
