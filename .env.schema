# BadDocs environment variable schema
# This file is committed to git. It contains NO secret values.
# Actual values go in .env (git-ignored).
# Used by varlock for validation: varlock run -- baddocs generate
# Also serves as the source of truth for pydantic-settings (src/baddocs/config/settings.py)
#
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ============================================================================
# LOCAL LLM (FREE — no API key needed)
# ============================================================================

# URL for a running Ollama instance
# @type=url
OLLAMA_URL=http://localhost:11434

# URL for a running llama.cpp llama-server instance
# @type=url
LLAMACPP_URL=http://localhost:8080

# ============================================================================
# CLOUD LLM API KEYS (set at least one for cloud fallback)
# ============================================================================

# DeepSeek API key — cheapest cloud option (~$0.14/1M tokens)
# @sensitive=true
DEEPSEEK_API_KEY=

# Alibaba Qwen API key
# @sensitive=true
QWEN_API_KEY=

# OpenAI API key (GPT-4o, GPT-4o-mini)
# @sensitive=true
OPENAI_API_KEY=

# Anthropic API key (Claude)
# @sensitive=true
ANTHROPIC_API_KEY=

# ============================================================================
# LLM ROUTING & COST MANAGEMENT
# ============================================================================

# Cost tier controlling which models are eligible for selection
# @type=enum(free,ultra_budget,budget,standard,full)
BADDOCS_MVP_TIER=budget

# Monthly LLM spend budget in USD — analysis pauses when exceeded
# @type=number @min=0
BADDOCS_MONTHLY_BUDGET=20

# Enable per-request cost tracking to the SQLite database
# @type=boolean
BADDOCS_TRACK_COSTS=true

# Automatically downgrade to cheaper models when approaching budget limit
# @type=boolean
BADDOCS_AUTO_DOWNGRADE=true

# Model routing strategy
# @type=enum(intelligent,cost_optimized,round_robin,single_model)
BADDOCS_ROUTING_MODE=intelligent

# ============================================================================
# MODEL OVERRIDES (optional — routing handles this automatically)
# ============================================================================

# Force a specific model for all tasks (overrides routing)
# @type=string
BADDOCS_PREFERRED_MODEL=

# Per-task model overrides
BADDOCS_MODEL_CODE_DOCS=
BADDOCS_MODEL_API_DOCS=
BADDOCS_MODEL_ARCHITECTURE=
BADDOCS_MODEL_CODE_REVIEW=
BADDOCS_MODEL_DATABASE_DOCS=

# ============================================================================
# APPLICATION
# ============================================================================

# Path to the YAML providers configuration file
# @type=string
BADDOCS_CONFIG=config/providers.yml

# Log verbosity
# @type=enum(DEBUG,INFO,WARNING,ERROR)
BADDOCS_LOG_LEVEL=INFO

# Directory for SQLite database and analysis output
# @type=string
BADDOCS_DATA_DIR=data

# Directory for log files
# @type=string
BADDOCS_LOG_DIR=logs

# Path to the SQLite database file
# @type=string
STORAGE_DB_PATH=/app/data/baddocs.db

# ============================================================================
# WEB SERVER
# ============================================================================

# Port for the FastAPI web interface
# @type=number @min=1 @max=65535
PORT=8000

# Host binding address (use 0.0.0.0 for production)
# @type=string
HOST=0.0.0.0

# Deployment environment
# @type=enum(development,staging,production)
ENVIRONMENT=development

# ============================================================================
# MCP ORCHESTRATION
# ============================================================================

# URL of the MCP orchestrator service
# Development: http://host.docker.internal:8001
# Docker Compose: http://mcp-orchestrator:8001
# @type=url
MCP_ORCHESTRATOR_URL=http://host.docker.internal:8001

# Enable MCP orchestration (set false to use direct-import fallback mode)
# @type=boolean
MCP_ENABLED=true

# ============================================================================
# GITHUB APP (for private repository analysis)
# See GITHUB_APP_SETUP.md for setup instructions
# ============================================================================

# GitHub App numeric ID
# @type=number
GITHUB_APP_ID=

# GitHub App private key — paste full PEM contents or use PATH variant below
# @sensitive=true
GITHUB_APP_PRIVATE_KEY=

# Path to GitHub App private key .pem file (alternative to inline key)
# @type=string
GITHUB_APP_PRIVATE_KEY_PATH=

# Secret for validating incoming GitHub webhook payloads
# @sensitive=true
GITHUB_WEBHOOK_SECRET=

# ============================================================================
# LIVE DATABASE CONNECTION (for database schema documentation)
# Leave blank to skip database documentation
# ============================================================================

# @type=enum(postgresql,mysql,mssql,sqlite)
DATABASE_TYPE=

DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USER=

# @sensitive=true
DATABASE_PASSWORD=
