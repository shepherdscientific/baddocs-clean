# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/baddocs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false
DATABASE_TIMEOUT=30

# LLM Configuration
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
LLM_MODEL=claude-3-opus-20240229
LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Optional: Alternative LLM Providers
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4
# COHERE_API_KEY=your_api_key_here
# GEMINI_API_KEY=your_api_key_here
# BEDROCK_REGION=us-east-1

# Storage Configuration
STORAGE_TYPE=local
STORAGE_PATH=/tmp/baddocs

# Optional: S3 Storage
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_S3_BUCKET=your_bucket
# AWS_REGION=us-east-1

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_RELOAD=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Analysis Configuration
ANALYSIS_TIMEOUT=600
ANALYSIS_MAX_FILE_SIZE=10485760
ANALYSIS_CACHE_SIZE=1000
ANALYSIS_INCREMENTAL=true

# Git Configuration
GIT_TIMEOUT=30
GIT_SHALLOW_CLONE=false
GIT_MAX_DEPTH=50

# Cache Configuration
CACHE_TTL=3600
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# Feature Flags
FEATURE_INCREMENTAL_ANALYSIS=true
FEATURE_CROSS_LANGUAGE_ANALYSIS=true
FEATURE_PATTERN_DETECTION=true
FEATURE_QUALITY_METRICS=true
