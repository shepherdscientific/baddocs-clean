# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/baddocs
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/baddocs_test

# Application Configuration
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here

# LLM Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo
ANTHROPIC_API_KEY=your-anthropic-api-key

# GitHub Configuration
GITHUB_TOKEN=your-github-token
GITHUB_APP_ID=your-app-id
GITHUB_PRIVATE_KEY=your-private-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/baddocs/app.log

# Cache Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# Storage Configuration
STORAGE_PATH=/data/baddocs
BACKUP_PATH=/backups/baddocs

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Features
ENABLE_INCREMENTAL_PROCESSING=true
ENABLE_CACHING=true
ENABLE_ANALYSIS=true
